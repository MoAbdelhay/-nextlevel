// Cloudflare Workers config for Mouj.
// Pages and images are served straight from public/; the Worker handles /api/* and /healthz.
// Secrets (set in the dashboard or with `npx wrangler secret put`): SUPABASE_URL, SUPABASE_SECRET_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mouj",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
